  "derived_field_definitions": [
    {
      "field": "maker_clean",
      "definition": "maker with surrounding whitespace removed. A case variant is mapped to the single most frequent spelling of that same case-folded name. The source maker column is unchanged."
    },
    {
      "field": "model_clean",
      "definition": "model with surrounding whitespace removed. Internal spaces are kept. Models are not renamed, and Unknown is not converted to null."
    },
    {
      "field": "fuel_category",
      "definition": "Exact copy of the source fuel code. greendiesel is not merged into diesel, and dual-fuel codes are not merged into petrol or diesel."
    },
    {
      "field": "state_category",
      "definition": "Exact copy of the source state value. Rakan Niaga stays Rakan Niaga and is not assigned to a geographic state."
    },
    {
      "field": "is_rakan_niaga",
      "definition": "1 when state is exactly Rakan Niaga, otherwise 0."
    },
    {
      "field": "is_electric",
      "definition": "1 when fuel is exactly electric, otherwise 0. Maker and model are not used."
    },
    {
      "field": "is_hybrid",
      "definition": "1 when fuel is hybrid_petrol or hybrid_diesel, otherwise 0."
    },
    {
      "field": "registration_year",
      "definition": "Calendar year of date_reg."
    },
    {
      "field": "registration_month",
      "definition": "Calendar month of date_reg as an integer from 1 to 12."
    },
    {
      "field": "registration_month_number",
      "definition": "Same value as registration_month. Both names are stored so either can be used."
    },
    {
      "field": "registration_month_name",
      "definition": "English month name of date_reg, from a fixed list rather than the machine locale."
    },
    {
      "field": "registration_quarter",
      "definition": "Calendar quarter of date_reg, from 1 to 4."
    },
    {
      "field": "registration_year_month",
      "definition": "date_reg formatted as YYYY-MM."
    }
  ],
  "omitted_fields": [
    {
      "field": "is_internal_combustion",
      "reason": "is_internal_combustion is not created. greendiesel, dual-fuel codes, hydrogen, natural gas, other, and unknown cannot be classified as internal combustion from this dataset without an extra assumption. Electric and hybrid flags are set only from explicit source fuel values."
    }
  ],
