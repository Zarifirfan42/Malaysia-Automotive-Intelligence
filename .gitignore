# Re-downloadable JPJ source files. Rebuild with: python -m src
data/raw/*.parquet
data/raw/*.csv
data/raw/*.partial

# Processed Parquet is rebuilt by: python -m src.transformation
# Audit files under data/quality and data/processed/dataset_metadata.json stay visible.
data/processed/**/*.parquet
data/processed/**/*.partial
data/processed/_building/
data/processed/_previous/

# DuckDB file is rebuilt by: python -m src.analytical
data/analytical/*.duckdb
data/analytical/*.duckdb.wal

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# IDE and OS
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# Secrets
.env
.env.*
